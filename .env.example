# Copy to .env.local for local dev, and add the same in Vercel > Settings > Environment Variables

# --- Supabase (OPTIONAL) ---
# If these are blank, the contact + newsletter forms still work in demo mode
# (they show a success message and log to the server console instead of saving).
# Fill them in to save submissions to your Supabase project (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site links ---
# Where the "Pay Your Bill" button should go (Stripe Payment Link, Square, etc.)
NEXT_PUBLIC_PAY_BILL_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
